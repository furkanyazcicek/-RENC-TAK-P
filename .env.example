# ============================================================
# İSTEMCİ (tarayıcıya gömülür — Vite yalnızca VITE_ öneklileri gömer)
# ============================================================
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ============================================================
# SUNUCU (AI Koç — /api altındaki fonksiyonlar okur)
# ------------------------------------------------------------
# DİKKAT: Bu değişkenlerin HİÇBİRİ "VITE_" ile başlamamalıdır.
# VITE_ öneki eklenirse Vite bu değeri build çıktısına gömer ve
# OpenAI anahtarınız tarayıcıdan görülebilir hale gelir.
#
# Vercel'de: Project Settings > Environment Variables
# ============================================================

# OpenAI API anahtarı — ZORUNLU
OPENAI_API_KEY=sk-...

# Kullanılacak model. Kod içinde hiçbir yerde model adı yazılı değildir;
# değiştirmek için yalnızca bu değeri güncellemeniz yeterlidir.
AI_MODEL=gpt-4o-mini

# Sohbet başlığı gibi ucuz işler için kullanılacak model (isteğe bağlı;
# boş bırakılırsa AI_MODEL kullanılır)
# AI_UTILITY_MODEL=gpt-4o-mini

# Supabase — sunucu tarafı. ANON (publishable) anahtar kullanılır,
# service_role DEĞİL: sunucu öğrencinin kendi JWT'siyle sorgu attığı için
# tüm erişim RLS'ten geçer.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# ---- İsteğe bağlı ayarlar (varsayılanlar api/_lib/config.js içinde) ----
# AI_TEMPERATURE=0.6
# AI_MAX_OUTPUT_TOKENS=1200
# AI_REQUEST_TIMEOUT_MS=60000
# AI_MAX_TOOL_ROUNDS=4
# AI_RATE_LIMIT_HOUR=30
# AI_RATE_LIMIT_DAY=120
# AI_MAX_USER_MESSAGE_CHARS=2000


# ============================================================
# AI SORU ÇÖZÜM MERKEZİ (/soru-coz — Google Gemini)
# ------------------------------------------------------------
# AI Koç'tan BAĞIMSIZDIR: farklı sağlayıcı, farklı anahtar, farklı
# limitler. Biri olmadan diğeri çalışmaya devam eder.
#
# DİKKAT: Buradaki hiçbir değişken "VITE_" ile başlamamalıdır.
# VITE_ öneki eklenirse Vite bu değeri build çıktısına gömer ve
# Gemini anahtarınız tarayıcıdan görülebilir hale gelir.
# ============================================================

# Google AI Studio'dan alınan anahtar — ZORUNLU
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Kullanılacak modeller. Kod içinde hiçbir yerde model adı yazılı
# DEĞİLDİR; değiştirmek için yalnızca bu iki değeri güncelleyin.
#
# ⚠️ Model katalogları aylar içinde değişiyor. Kimliğin var olması
# KULLANABİLDİĞİNİZ anlamına gelmez: 2026-08-17'de gemini-3.1-pro-preview
# katalogda görünüyor ama ÜCRETSİZ KATMANDA kotası sıfır (429 "limit: 0").
# Hangi modelin gerçekten çalıştığını `npm run diagnose:solve` söyler.
#
#   fast → triyaj (soruyu sınıflandırma) ve kolay soruların çözümü
#   pro  → zor sorular, düşük güvenli cevapların yeniden çözümü,
#          öğrencinin kendi çözümünün kontrolü
#
# ⚠️ "Pro" bir ROL adıdır, model ailesi değil. Ölçüm sonucu buraya gerçek
# Pro modeli DEĞİL, gemini-3.7-flash kondu: aynı doğru cevabı dörtte bir
# sürede ve dörtte bir fiyata veriyor (ayrıntı config.js'de).
GEMINI_FAST_MODEL=gemini-3.6-flash
GEMINI_PRO_MODEL=gemini-3.7-flash

# ---- Fiyatlandırma ($ / 1 milyon token) ----
# Varsayılanlar 2026-08-17'de Google'ın resmî sayfasından alındı
# (ai.google.dev/gemini-api/docs/pricing). Modeli değiştirirseniz bu
# değerler de değişmeli: fiyatlar model kimliğine değil ROLE bağlıdır.
# SOLVE_PRICE_FAST_IN=0.75         (1 Ocak 2027'de 1.5'e çıkıyor)
# SOLVE_PRICE_FAST_OUT=3.75        (1 Ocak 2027'de 7.5'e çıkıyor)
# SOLVE_PRICE_PRO_IN=0.75          (gemini-3.1-pro-preview'e dönerseniz 2.0)
# SOLVE_PRICE_PRO_OUT=3.75         (gemini-3.1-pro-preview'e dönerseniz 12.0)

# ---- Hız sınırı (öğrenci başına) ----
# AI_DAILY_LIMIT, SOLVE_LIMIT_DAY'in takma adıdır.
# AI_DAILY_LIMIT=60
# SOLVE_LIMIT_HOUR=25
# SOLVE_LIMIT_MINUTE=4

# ---- İsteğe bağlı ayarlar (varsayılanlar api/_lib/solve/config.js) ----
# GEMINI_MAX_OUTPUT_TOKENS=16000   (düşünme token'ları da bu tavandan harcanır)
# GEMINI_TIMEOUT_MS=45000
# GEMINI_TEMPERATURE=0
# GEMINI_MAX_RETRIES=2
#
# Süre bütçeleri — vercel.json'daki maxDuration'ın ALTINDA kalmalı.
# Fonksiyon kesilirse öğrenci hata bile göremez, ekranda çark döner.
# SOLVE_TOTAL_BUDGET_MS=110000     (solve.js / check.js = 120sn)
# SOLVE_ASK_BUDGET_MS=38000        (ask.js = 45sn)
#
# Düşünme düzeyi: minimal | low | medium | high (KAPATILAMAZ).
# Düşünme token'ları FATURALANIR ve SÜRE demektir; ölçüm için config.js'e
# bakın. Zor soruda 'low' yanlış cevaba götürdü, 'high' medium'a bir şey
# katmadı — bu yüzden pro varsayılanı 'medium'.
# GEMINI_THINKING_TRIAGE=low
# GEMINI_THINKING_FAST=low
# GEMINI_THINKING_PRO=medium
#
# Yönlendirme eşikleri — Flash/Pro dengesi buradan ayarlanır.
# SOLVE_ESCALATE_CONF=0.75     (bu güvenin altında Pro'ya yükselt)
# SOLVE_REFUSE_CONF=0.4        (bu güvenin altında ÇÖZÜM GÖSTERME)
# SOLVE_PRO_DIFFICULTY=4       (bu zorluktan itibaren doğrudan Pro)
# SOLVE_PRO_STEPS=7
